{
  "permissions": {
    "deny": [
      "Bash(*--remote*)",
      "Bash(*wrangler*--preview*)",
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler pages deploy*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler versions upload*)",
      "Bash(*wrangler publish*)",
      "Bash(*wrangler d1 create*)",
      "Bash(*wrangler d1 delete*)",
      "Bash(*wrangler d1 list*)",
      "Bash(*wrangler d1 info*)",
      "Bash(*wrangler d1 time-travel*)",
      "Bash(*wrangler d1 migrations apply*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-wrangler.mjs\"",
            "onFailure": "block",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
